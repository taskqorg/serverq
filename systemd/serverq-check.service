[Unit]
Description=ServerQ read-only server compliance audit

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.serverq/app/serverq.py check
SuccessExitStatus=1
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.serverq
MemoryMax=128M
TasksMax=32
TimeoutStartSec=90
